+                    text_align: center
+                    text_color: 0xFFFFFF
+                    text_font: roboto14_font
+                - label:
+                    text: "Toggle"
+                    align: center
+                    y: 45
+                    width: 80
+                    text_align: center
+                    text_color: 0xAAAAAA
+                    text_font: roboto12_font
+          
+          - button:
